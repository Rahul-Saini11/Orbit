{
  "name": "terminal-coding-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "code-agent": "dist/index.js"
  },
  "scripts": {
    "dev": "tsx --env-file=.env src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "tsx": "^4.20.0",
    "typescript": "^5.8.0"
  }
}
